# Ejemplo de configuración de firma de Release para Aura Eventos
# Copia este archivo como 'keystore.properties' (sin .example) y reemplaza los valores por tus credenciales.
# NUNCA subas 'keystore.properties' ni la llave '.jks' al repositorio Git.
#
# Comando para generar la llave de release con keytool:
# keytool -genkeypair -v -keystore aura-release.jks -alias aura-key -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=Aura Eventos, O=Aura Eventos, C=MX" -storepass TU_CONTRASEÑA -keypass TU_CONTRASEÑA

storePassword=TU_CONTRASEÑA_STORE
keyPassword=TU_CONTRASEÑA_KEY
keyAlias=aura-key
storeFile=aura-release.jks
